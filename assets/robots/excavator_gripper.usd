#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (0, 0, 500)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (1.1103481106390256, 0.7887348649078475, 0.8251966352203487)
                double3 target = (0.03910492825077272, -0.027638623229043646, 0.01287146852787302)
            }
            dictionary Right = {
                double3 position = (-500, 0, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 500, 0)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./excavator.usd"
        }
        dictionary renderSettings = {
        }
    }
    doc = "Excavator with gripper"
)

def Xform "excavator" (
    apiSchemas = ["PhysicsArticulationRootAPI", "IsaacRobotAPI", "PhysxArticulationAPI"]
)
{
    string isaac:namespace (
        displayName = "Namespace"
        doc = "Namespace of the prim in Isaac Sim"
    )
    rel isaac:physics:robotJoints = [
        </excavator/Joints/revolute_carriage>,
        </excavator/Joints/revolute_lift>,
        </excavator/Joints/revolute_tilt>,
        </excavator/Joints/revolute_tool>,
        </excavator/Joints/revolute_gripper>,
        </excavator/Joints/revolute_claw_1>,
        </excavator/Joints/revolute_claw_2>,
        </excavator/Joints/gripper_to_tool>,
    ]
    rel isaac:physics:robotLinks = [
        </excavator/lower_carriage>,
        </excavator/upper_carriage>,
        </excavator/lift_boom>,
        </excavator/tilt_boom>,
        </excavator/tool_body>,
        </excavator/gripper_mount>,
        </excavator/gripper_frame>,
        </excavator/gripper_claw_1>,
        </excavator/gripper_claw_2>,
