    def OmniGraph "BucketExcavatorActionGraph" (
        customData = {
            dictionary bucket_control_contract = {
                string action_order = "left_stick_x_slew, left_stick_y_arm, right_stick_x_bucket, right_stick_y_boom"
                string control_enabled = "/kaivuri/control_enabled (False holds current pose; startup default)"
                string gripper = "not present"
                string joint_order = "revolute_carriage, revolute_tilt, revolute_tool, revolute_lift"
                string source_selection = "/kaivuri/recording_mode: True gamepad, False /kaivuri/policy_action"
                string world_level_compensation = "disabled; revolute_tool receives only its commanded joint delta"
            }
            string claw_toggle_source = "reference/isaac_excavator_joystick.usd"
            int simulation_dagger_version = 2
            dictionary splat_joint_speed_contract = {
                string joint_delta_per_normalized_60hz_step_rad = "-0.004, -0.004, -0.008, 0.003"
                string joint_order = "revolute_carriage, revolute_tilt, revolute_tool, revolute_lift"
                string revolute_tool = "2x its previous rate; all other joint rates unchanged"
            }
        }
    )
    {
        token evaluationMode = "Automatic"
        token evaluator:type = "execution"
        token fabricCacheBacking = "StageWithoutHistory"
        int2 fileFormatVersion = (1, 9)
        token pipelineStage = "pipelineStageSimulation"

