def setup(db):
    db.per_instance_state.input_interface = None
    db.per_instance_state.gamepad = None
    db.per_instance_state.button = None
    db.per_instance_state.was_pressed = False

    try:
        import carb.input
        import omni.appwindow

        candidates = ('LEFT_SHOULDER', 'LEFT_BUMPER', 'LB')
        button = None
        for candidate in candidates:
            for enum_name in (candidate, candidate + \"_BUTTON\", \"BUTTON_\" + candidate):
                if hasattr(carb.input.GamepadInput, enum_name):
                    button = getattr(carb.input.GamepadInput, enum_name)
                    break
            if button is not None:
                break
        if button is None:
            print(\"[GamepadEpisodeStartButton] Could not resolve Xbox button; tried \" + repr(candidates), flush=True)
            return

        appwindow = omni.appwindow.get_default_app_window()
        db.per_instance_state.input_interface = carb.input.acquire_input_interface()
        db.per_instance_state.gamepad = appwindow.get_gamepad(0)
        db.per_instance_state.button = button
        print(\"[GamepadEpisodeStartButton] Polling Xbox episode button.\", flush=True)
    except Exception as exc:
        print(\"[GamepadEpisodeStartButton] Failed to initialize: \" + str(exc), flush=True)


def compute(db):
    state = db.per_instance_state
    pressed = False
    if state.input_interface is not None and state.gamepad is not None and state.button is not None:
        try:
            pressed = float(state.input_interface.get_gamepad_value(state.gamepad, state.button)) > 0.5
        except Exception:
            pressed = False
    db.outputs.pressed = pressed and not state.was_pressed
    state.was_pressed = pressed
    return True
"""
