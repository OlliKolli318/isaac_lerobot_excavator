            custom string inputs:script = """
def setup(db):
    db.per_instance_state.input_interface = None
    db.per_instance_state.gamepad = None
    db.per_instance_state.button = None

    try:
        import carb.input
        import omni.appwindow

        candidates = (
            'A',
            'A_BUTTON',
            'BUTTON_A',
        )
        button = None
        for candidate in candidates:
            if hasattr(carb.input.GamepadInput, candidate):
                button = getattr(carb.input.GamepadInput, candidate)
                break
        if button is None:
            print(\"[GamepadClawToggleButton] Could not resolve Xbox A button input.\", flush=True)
            return

        appwindow = omni.appwindow.get_default_app_window()
        db.per_instance_state.input_interface = carb.input.acquire_input_interface()
        db.per_instance_state.gamepad = appwindow.get_gamepad(0)
        db.per_instance_state.button = button
        print(\"[GamepadClawToggleButton] Polling Xbox A button.\", flush=True)
    except Exception as exc:
        print(f\"[GamepadClawToggleButton] Failed to initialize: {exc}\", flush=True)


def compute(db):
    state = db.per_instance_state
    pressed = False
    if state.input_interface is not None and state.gamepad is not None and state.button is not None:
        try:
            pressed = float(state.input_interface.get_gamepad_value(state.gamepad, state.button)) > 0.5
        except Exception:
            pressed = False
    db.outputs.pressed = pressed
    return True
"""
            custom token inputs:scriptPath
            custom bool inputs:usePath
            token node:type = "omni.graph.scriptnode.ScriptNode"
            int node:typeVersion = 2
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
            custom bool outputs:pressed
            custom bool state:omni_initialized
        }

