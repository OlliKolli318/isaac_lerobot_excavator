        {
            token node:type = "omni.graph.action.OnPlaybackTick"
            int node:typeVersion = 2
            custom double outputs:deltaSeconds
            custom double outputs:frame
            custom uint outputs:tick (
                customData = {
                    bool isExecution = 1
                }
            )
            custom double outputs:time
        }

        def OmniGraphNode "ReadSimTime"
        {
            custom uint64 inputs:referenceTimeDenominator
            custom int64 inputs:referenceTimeNumerator
            custom bool inputs:resetOnStop = 1
            token node:type = "isaacsim.core.nodes.IsaacReadSimulationTime"
            int node:typeVersion = 1
            custom double outputs:simulationTime
        }

        def OmniGraphNode "ReadCubePose"
        {
            custom rel inputs:prim = </World/Low_Poly_Log> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            token node:type = "isaacsim.core.nodes.IsaacReadWorldPose"
            int node:typeVersion = 2
            custom quatd outputs:orientation
            custom vector3d outputs:scale
            custom vector3d outputs:translation
        }

        def OmniGraphNode "ReadGoalPose"
        {
            custom rel inputs:prim = </World/Garbage_Container_Blue/Goal_plane> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            token node:type = "isaacsim.core.nodes.IsaacReadWorldPose"
            int node:typeVersion = 2
            custom quatd outputs:orientation
            custom vector3d outputs:scale
            custom vector3d outputs:translation
        }

        def OmniGraphNode "ReadUpperCarriagePose"
        {
            custom rel inputs:prim = </World/excavator/upper_carriage> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            token node:type = "isaacsim.core.nodes.IsaacReadWorldPose"
            int node:typeVersion = 2
            custom quatd outputs:orientation
            custom vector3d outputs:scale
            custom vector3d outputs:translation
        }

        def OmniGraphNode "ObjectRelocator"
        {
            custom vector3d inputs:cubeTranslation
            prepend vector3d inputs:cubeTranslation.connect = </World/ObjectRelocationGraph/ReadCubePose.outputs:translation>
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/ObjectRelocationGraph/OnPlaybackTick.outputs:tick>
            custom vector3d inputs:goalTranslation
            prepend vector3d inputs:goalTranslation.connect = </World/ObjectRelocationGraph/ReadGoalPose.outputs:translation>
            custom string inputs:script = """# Low_Poly_Log relocation for the splat environment. OmniGraph ScriptNode code.
import math
import random
import sys
import types

import omni.usd
from pxr import Gf, UsdGeom

SPLAT_RELOC_LOG = '/World/Low_Poly_Log'
SPLAT_RELOC_GOAL = '/World/Garbage_Container_Blue/Goal_plane'
SPLAT_RELOC_AREA = '/World/Cube_01'
SPLAT_RELOC_GROUND = '/World/Ground'
SPLAT_RELOC_DELAY_S = 0.5
SPLAT_RELOC_COOLDOWN_S = 0.5
SPLAT_RELOC_CLEARANCE_M = 0.002
SPLAT_RELOC_MIN_YAW_DEG = -5.0
SPLAT_RELOC_MAX_YAW_DEG = 5.0
SPLAT_RELOC_CONTACT_MARGIN_M = 0.005
SPLAT_RELOC_CONTACT_Z_TOLERANCE_M = 0.012
SPLAT_RELOC_CONTACT_HOLD_TICKS = 3
SPLAT_RELOC_OUTSIDE_XY_MARGIN_M = 0.5
SPLAT_RELOC_OUTSIDE_DROP_MARGIN_M = 0.25
SPLAT_RELOC_OUTSIDE_HOLD_S = 0.25
SPLAT_RELOC_EPISODE_COMMAND_TOPIC = '/kaivuri/episode_command'
SPLAT_RELOC_EPISODE_STATUS_TOPIC = '/kaivuri/episode/status'
SPLAT_RELOC_RECORDING_MODE_TOPIC = '/kaivuri/recording_mode'


def splat_reloc_install_rosidl_shims():
    if 'rosidl_pycommon.interface_base_classes' in sys.modules:
        return
    package = types.ModuleType('rosidl_pycommon')
    package.__path__ = []
    module = types.ModuleType('rosidl_pycommon.interface_base_classes')
    class MessageTypeSupportMeta(type):
        pass
    class ServiceTypeSupportMeta(type):
        pass
    class BaseMessage:
        pass
    class BaseService:
        def __class_getitem__(cls, item):
            return cls
    module.MessageTypeSupportMeta = MessageTypeSupportMeta
    module.ServiceTypeSupportMeta = ServiceTypeSupportMeta
    module.BaseMessage = BaseMessage
    module.BaseService = BaseService
    package.interface_base_classes = module
    sys.modules['rosidl_pycommon'] = package
    sys.modules['rosidl_pycommon.interface_base_classes'] = module


def setup(db):
    state = db.per_instance_state
    state.last_sim_time = None
    state.area = None
    state.area_missing_reported = False
    state.initialized = False
    state.touch_ticks = 0
    state.success_at = None
    state.waiting_for_save = False
    state.save_requested = False
    state.saved_ack = False
    state.outside_since = None
    state.waiting_for_discard = False
    state.discard_requested = False
    state.discarded_ack = False
    state.cooldown_until = -1.0
    state.recording_mode = None
    state.episode_active = False
    state.episode_ending = False
    state.dagger_control = ''
    state.continue_control = ''
    state.rng = random.Random()
    state.ros_node = None
    state.command_publisher = None
    state.string_type = None
    try:
        splat_reloc_install_rosidl_shims()
        import rclpy
        from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
        from std_msgs.msg import Bool, String
        if not rclpy.ok():
            rclpy.init(args=None)
        state.ros_node = rclpy.create_node('splat_log_relocator')
        state.command_publisher = state.ros_node.create_publisher(
            String, SPLAT_RELOC_EPISODE_COMMAND_TOPIC, 10)
        state.ros_node.create_subscription(
            String, SPLAT_RELOC_EPISODE_STATUS_TOPIC,
            lambda msg: splat_reloc_on_status(db, msg), 10)
        state.ros_node.create_subscription(
            String, SPLAT_RELOC_EPISODE_COMMAND_TOPIC,
            lambda msg: splat_reloc_on_command(db, msg), 10)
        mode_qos = QoSProfile(depth=1, reliability=ReliabilityPolicy.RELIABLE,
                              durability=DurabilityPolicy.TRANSIENT_LOCAL)
        state.ros_node.create_subscription(
            Bool, SPLAT_RELOC_RECORDING_MODE_TOPIC,
            lambda msg: splat_reloc_on_mode(db, msg), mode_qos)
        state.ros_node.create_subscription(
            String, '/kaivuri/dagger/state',
            lambda msg: setattr(state, 'dagger_control', str(msg.data)), mode_qos)
        state.ros_node.create_subscription(
            String, '/kaivuri/dagger/continue_after_success',
            lambda msg: setattr(state, 'continue_control', str(msg.data)), 10)
        state.string_type = String
    except Exception as exc:
        print('[SplatLogRelocator] ROS episode integration disabled: ' + str(exc), flush=True)


def cleanup(db):
    node = getattr(db.per_instance_state, 'ros_node', None)
    if node is not None:
        try:
            node.destroy_node()
        except Exception:
            pass


def splat_reloc_on_status(db, msg):
    state = db.per_instance_state
    status = str(msg.data).strip()
    if status in ('saved', 'discarded'):
        state.episode_active = False
        state.episode_ending = False
    # Corrections-only DAgger can complete a goal without any expert frames.
    # Its discarded/empty acknowledgement must also release the successful log.
    if state.waiting_for_save and status in ('saved', 'discarded'):
        state.saved_ack = True
    if state.waiting_for_discard and state.discard_requested and status == 'discarded':
        state.discarded_ack = True


def splat_reloc_on_command(db, msg):
    state = db.per_instance_state
    command = str(msg.data).strip()
    if command == 'start':
        state.episode_active = True
        state.episode_ending = False
        print('[SplatLogRelocator] Recording episode started.', flush=True)
    elif command in ('end_save', 'end_discard') and not (
            state.waiting_for_save or state.waiting_for_discard):
        # A manual stop command is not an acknowledgement. The recorder can
        # still be finishing its episode; defer automatic resets until it ends.
        state.episode_ending = state.episode_active


def splat_reloc_on_mode(db, msg):
    db.per_instance_state.recording_mode = bool(msg.data)


def splat_reloc_spin_ros(db):
    node = db.per_instance_state.ros_node
    if node is None:
        return
    try:
        import rclpy
        rclpy.spin_once(node, timeout_sec=0.0)
    except Exception as exc:
        print('[SplatLogRelocator] ROS spin failed: ' + str(exc), flush=True)


def splat_reloc_continue_policy(state):
    control = getattr(state, 'dagger_control', '')
    return (bool(control) and control.endswith(':autonomous')
            and control == getattr(state, 'continue_control', ''))


def splat_reloc_publish_save(db):
    state = db.per_instance_state
    if state.command_publisher is None or state.string_type is None:
        return False
    try:
        msg = state.string_type()
        msg.data = 'end_save'
        state.command_publisher.publish(msg)
        print('[SplatLogRelocator] Published end_save after 0.5 simulated seconds.', flush=True)
        return True
    except Exception as exc:
        print('[SplatLogRelocator] Could not publish end_save: ' + str(exc), flush=True)
        return False


def splat_reloc_publish_discard(db):
    state = db.per_instance_state
    if state.command_publisher is None or state.string_type is None:
        return False
    try:
        msg = state.string_type()
        msg.data = 'end_discard'
        state.command_publisher.publish(msg)
        print('[SplatLogRelocator] Published end_discard for an out-of-bounds log.', flush=True)
        return True
    except Exception as exc:
        print('[SplatLogRelocator] Could not publish end_discard: ' + str(exc), flush=True)
        return False


def splat_reloc_box(stage, path):
    prim = stage.GetPrimAtPath(path)
    if not prim:
        return None
    cache = UsdGeom.BBoxCache(0.0, ['default', 'render', 'proxy'], False, True)
    box = cache.ComputeWorldBound(prim).ComputeAlignedBox()
    if box.IsEmpty() or not all(math.isfinite(value)
                               for point in (box.GetMin(), box.GetMax()) for value in point):
        return None
    return box


def splat_reloc_read_area(stage):
    marker = stage.GetPrimAtPath(SPLAT_RELOC_AREA)
    if not marker:
        return None
    cache = UsdGeom.BBoxCache(0.0, ['default', 'render', 'proxy'], False, True)
    # ComputeUntransformedBound excludes Cube_01's own xform; applying its
    # local-to-world matrix below therefore transforms the marker exactly once.
    local = cache.ComputeUntransformedBound(marker).ComputeAlignedBox()
    low, high = local.GetMin(), local.GetMax()
    matrix = UsdGeom.XformCache().GetLocalToWorldTransform(marker)
    z = (low[2] + high[2]) * 0.5
    p00 = matrix.Transform(Gf.Vec3d(low[0], low[1], z))
    p10 = matrix.Transform(Gf.Vec3d(high[0], low[1], z))
    p01 = matrix.Transform(Gf.Vec3d(low[0], high[1], z))
    u = Gf.Vec2d(p10[0] - p00[0], p10[1] - p00[1])
    v = Gf.Vec2d(p01[0] - p00[0], p01[1] - p00[1])
    width, height = u.GetLength(), v.GetLength()
    if width <= 1e-6 or height <= 1e-6:
        return None
    u /= width
    v /= height
    center = Gf.Vec2d(p00[0], p00[1]) + u * (width * 0.5) + v * (height * 0.5)
    imageable = UsdGeom.Imageable(marker)
    if imageable:
        imageable.CreateVisibilityAttr().Set('invisible')
    for name in ('physics:collisionEnabled', 'physics:rigidBodyEnabled'):
        attr = marker.GetAttribute(name)
        if attr:
            attr.Set(False)
    print('[SplatLogRelocator] Cached Cube_01 operating area; marker hidden and physics disabled.', flush=True)
    return (center, u, v, width * 0.5, height * 0.5)


def splat_reloc_set_position(stage, position):
    prim = stage.GetPrimAtPath(SPLAT_RELOC_LOG)
    if not prim:
        return False
    xformable = UsdGeom.Xformable(prim)
    for op in xformable.GetOrderedXformOps():
        if op.GetOpName() == 'xformOp:translate':
            op.Set(Gf.Vec3d(*position))
            break
    else:
        xformable.AddTranslateOp().Set(Gf.Vec3d(*position))
    for name in ('physics:velocity', 'physics:angularVelocity'):
        attr = prim.GetAttribute(name)
        if attr:
            attr.Set(Gf.Vec3f(0.0, 0.0, 0.0))
    return True


def splat_reloc_set_yaw(stage, yaw_degrees):
    prim = stage.GetPrimAtPath(SPLAT_RELOC_LOG)
    if not prim:
        return False
    xformable = UsdGeom.Xformable(prim)
    orient_op = None
    for op in xformable.GetOrderedXformOps():
        if op.GetOpType() == UsdGeom.XformOp.TypeOrient:
            orient_op = op
            break
    if orient_op is None:
        orient_op = xformable.AddOrientOp(UsdGeom.XformOp.PrecisionFloat)
    half_angle = math.radians(float(yaw_degrees)) * 0.5
    orient_op.Set(Gf.Quatf(
        float(math.cos(half_angle)),
        Gf.Vec3f(0.0, 0.0, float(math.sin(half_angle)))))
    return True


def splat_reloc_move(db, stage, reason):
    state = db.per_instance_state
    if state.area is None:
        state.area = splat_reloc_read_area(stage)
    if state.area is None:
        if not state.area_missing_reported:
            print('[SplatLogRelocator] /World/Cube_01 is missing. Save the marker in env.usd; relocation is paused.', flush=True)
            state.area_missing_reported = True
        return False
    ground_box = splat_reloc_box(stage, SPLAT_RELOC_GROUND)
    log_box = splat_reloc_box(stage, SPLAT_RELOC_LOG)
    log_prim = stage.GetPrimAtPath(SPLAT_RELOC_LOG)
    if ground_box is None or log_box is None or not log_prim:
        print('[SplatLogRelocator] Ground or log geometry is missing.', flush=True)
        return False
    # A fallen log may be tilted. Measure its footprint and bottom only after
    # restoring the spawn orientation, otherwise it can respawn above/in Ground.
    yaw = state.rng.uniform(SPLAT_RELOC_MIN_YAW_DEG, SPLAT_RELOC_MAX_YAW_DEG)
    if not splat_reloc_set_yaw(stage, yaw):
        return False
    log_box = splat_reloc_box(stage, SPLAT_RELOC_LOG)
    if log_box is None:
        return False
    meters_per_unit = UsdGeom.GetStageMetersPerUnit(stage)
    current = UsdGeom.XformCache().GetLocalToWorldTransform(log_prim).ExtractTranslation()
    low, high = log_box.GetMin(), log_box.GetMax()
    footprint_radius = 0.5 * math.hypot(high[0] - low[0], high[1] - low[1]) + 0.005 / meters_per_unit
    center, u, v, half_u, half_v = state.area
    usable_u, usable_v = half_u - footprint_radius, half_v - footprint_radius
    if usable_u <= 0.0 or usable_v <= 0.0:
        print('[SplatLogRelocator] Cube_01 is too small for the log footprint.', flush=True)
        return False
    du = state.rng.uniform(-usable_u, usable_u)
    dv = state.rng.uniform(-usable_v, usable_v)
    xy = center + u * du + v * dv
    bottom_offset = low[2] - current[2]
    z = ground_box.GetMax()[2] - bottom_offset + SPLAT_RELOC_CLEARANCE_M / meters_per_unit
    if not splat_reloc_set_position(stage, (xy[0], xy[1], z)):
        return False
    state.touch_ticks = 0
    state.success_at = None
    state.waiting_for_save = False
    state.save_requested = False
    state.saved_ack = False
    state.outside_since = None
    state.waiting_for_discard = False
    state.discard_requested = False
    state.discarded_ack = False
    state.cooldown_until = float(db.inputs.simTime) + SPLAT_RELOC_COOLDOWN_S
    print('[SplatLogRelocator] ' + reason + ' -> position ' +
          str([round(xy[0], 4), round(xy[1], 4), round(z, 4)]) +
          ', yaw ' + str(round(yaw, 3)) + ' deg', flush=True)
    return True


def splat_reloc_shifted_bounds(stage, path, box, live_translation):
    low, high = box.GetMin(), box.GetMax()
    if live_translation is None:
        return low, high
    try:
        values = [float(value) for value in live_translation]
        if len(values) < 3 or not all(math.isfinite(value) for value in values[:3]):
            return low, high
        prim = stage.GetPrimAtPath(path)
        authored = UsdGeom.XformCache().GetLocalToWorldTransform(prim).ExtractTranslation()
        delta = Gf.Vec3d(values[0] - authored[0], values[1] - authored[1], values[2] - authored[2])
        return low + delta, high + delta
    except Exception:
        return low, high


def splat_reloc_touches_goal(stage, log_translation=None, goal_translation=None):
    log_box = splat_reloc_box(stage, SPLAT_RELOC_LOG)
    goal_box = splat_reloc_box(stage, SPLAT_RELOC_GOAL)
    if log_box is None or goal_box is None:
        return False
    # ReadPrim supplies live physics poses even when Fabric has not written the
    # latest rigid-body transforms back into USD. Shift the authored geometry
    # bounds to those live translations before checking contact.
    lo0, lo1 = splat_reloc_shifted_bounds(
        stage, SPLAT_RELOC_LOG, log_box, log_translation)
    go0, go1 = splat_reloc_shifted_bounds(
        stage, SPLAT_RELOC_GOAL, goal_box, goal_translation)
    margin = SPLAT_RELOC_CONTACT_MARGIN_M
    overlap_xy = (lo1[0] >= go0[0] - margin and lo0[0] <= go1[0] + margin and
                  lo1[1] >= go0[1] - margin and lo0[1] <= go1[1] + margin)
    # The goal is a thin plane inside the container.  Test its complete
    # vertical slab: requiring the log centre to be above the plane rejected
    # valid placements where a horizontal log rests low in the container.
    near_surface = (lo0[2] <= go1[2] + SPLAT_RELOC_CONTACT_Z_TOLERANCE_M and
                    lo1[2] >= go0[2] - SPLAT_RELOC_CONTACT_Z_TOLERANCE_M)
    return overlap_xy and near_surface


def splat_reloc_outside_ground(stage, log_translation):
    # Use the live ReadPrim translation; USD can lag behind physics/Fabric.
    # Invalid/missing input must not accumulate escape time or trigger a reset.
    try:
        position = tuple(float(value) for value in log_translation)
    except (TypeError, ValueError):
        return False
    if len(position) != 3 or not all(math.isfinite(value) for value in position):
        return False
    ground = splat_reloc_box(stage, SPLAT_RELOC_GROUND)
    if ground is None:
        return False
    low, high = ground.GetMin(), ground.GetMax()
    meters_per_unit = UsdGeom.GetStageMetersPerUnit(stage)
    xy_margin = SPLAT_RELOC_OUTSIDE_XY_MARGIN_M / meters_per_unit
    drop_margin = SPLAT_RELOC_OUTSIDE_DROP_MARGIN_M / meters_per_unit
    dx = max(low[0] - position[0], 0.0, position[0] - high[0])
    dy = max(low[1] - position[1], 0.0, position[1] - high[1])
    return (dx * dx + dy * dy > xy_margin * xy_margin or
            position[2] < high[2] - drop_margin)


def compute(db):
    state = db.per_instance_state
    splat_reloc_spin_ros(db)
    stage = omni.usd.get_context().get_stage()
    if stage is None:
        return False
    sim_time = max(0.0, float(db.inputs.simTime))
    if state.last_sim_time is not None and sim_time < state.last_sim_time:
        state.initialized = False
        state.touch_ticks = 0
        state.success_at = None
        state.waiting_for_save = False
        state.save_requested = False
        state.saved_ack = False
        state.outside_since = None
        state.waiting_for_discard = False
        state.discard_requested = False
        state.discarded_ack = False
        state.episode_ending = False
        state.cooldown_until = -1.0
    state.last_sim_time = sim_time
    if state.area is None:
        state.area = splat_reloc_read_area(stage)
    if not state.initialized:
        if not splat_reloc_move(db, stage, 'initial relocation'):
            return True
        state.initialized = True
        return True
    if state.episode_ending:
        state.outside_since = None
        return True
    if state.waiting_for_save:
        if state.saved_ack:
            return splat_reloc_move(db, stage, 'saved episode relocation')
        return True
    if state.waiting_for_discard:
        if state.discarded_ack:
            return splat_reloc_move(db, stage, 'out-of-bounds relocation after discard')
        return True
    if state.success_at is not None:
        if sim_time - state.success_at < SPLAT_RELOC_DELAY_S:
            return True
        if splat_reloc_continue_policy(state):
            return splat_reloc_move(db, stage, 'successful task; continuing autonomous policy')
        # A save acknowledgement exists only while an episode started by LB is
        # active.  Manual mode without an active recorder must not leave the
        # log stuck in the container forever.
        if not state.episode_active:
            reason = ('inference relocation' if state.recording_mode is False
                      else 'unrecorded manual relocation')
            return splat_reloc_move(db, stage, reason)
        state.waiting_for_save = True
        state.save_requested = splat_reloc_publish_save(db)
        if not state.save_requested:
            print('[SplatLogRelocator] Successful log remains fixed because the recorder save request failed.', flush=True)
        return True
    if sim_time < state.cooldown_until:
        state.outside_since = None
        return True
    state.touch_ticks = state.touch_ticks + 1 if splat_reloc_touches_goal(
        stage, db.inputs.cubeTranslation, db.inputs.goalTranslation) else 0
    if state.touch_ticks >= SPLAT_RELOC_CONTACT_HOLD_TICKS:
        state.touch_ticks = 0
        state.success_at = sim_time
        state.outside_since = None
        print('[SplatLogRelocator] Goal contact; retaining success for 0.5 simulated seconds.', flush=True)
        return True
    if not splat_reloc_outside_ground(stage, db.inputs.cubeTranslation):
        state.outside_since = None
        return True
    if state.outside_since is None:
        state.outside_since = sim_time
    if sim_time - state.outside_since < SPLAT_RELOC_OUTSIDE_HOLD_S:
        return True
    state.touch_ticks = 0
    if not state.episode_active:
        return splat_reloc_move(db, stage, 'out-of-bounds relocation')
    # Latch the failure before publishing so our own command cannot bypass the
    # recorder acknowledgement. Never put the teleported pose in this episode.
    state.waiting_for_discard = True
    state.discard_requested = splat_reloc_publish_discard(db)
    if not state.discard_requested:
        print('[SplatLogRelocator] Out-of-bounds relocation is waiting because the recorder discard request failed.', flush=True)
    return True
"""
            custom token inputs:scriptPath
            custom double inputs:simTime
            prepend double inputs:simTime.connect = </World/ObjectRelocationGraph/ReadSimTime.outputs:simulationTime>
            custom quatd inputs:upperOrientation
            prepend quatd inputs:upperOrientation.connect = </World/ObjectRelocationGraph/ReadUpperCarriagePose.outputs:orientation>
            custom vector3d inputs:upperTranslation
            prepend vector3d inputs:upperTranslation.connect = </World/ObjectRelocationGraph/ReadUpperCarriagePose.outputs:translation>
            custom bool inputs:usePath
            token node:type = "omni.graph.scriptnode.ScriptNode"
            int node:typeVersion = 2
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
            custom bool state:omni_initialized
        }
    }
}

def Xform "Environment"
{
    quatd xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def DiskLight "DiskLight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
