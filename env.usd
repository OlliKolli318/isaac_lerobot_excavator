        def OmniGraphNode "ActionMux"
        {
            custom bool inputs:controlEnabled
            bool inputs:controlEnabled.connect = </World/BucketExcavatorActionGraph/ControlEnabledSubscriber.outputs:data>
            custom double[] inputs:currentJointPositions
            double[] inputs:currentJointPositions.connect = </World/BucketExcavatorActionGraph/ArticulationState.outputs:jointPositions>
            custom uint64 inputs:daggerLeftCount = 0
            uint64 inputs:daggerLeftCount.connect = </World/BucketExcavatorActionGraph/DaggerGamepadControls.outputs:leftCount>
            custom uint64 inputs:daggerRightCount = 0
            uint64 inputs:daggerRightCount.connect = </World/BucketExcavatorActionGraph/DaggerGamepadControls.outputs:rightCount>
            custom token inputs:daggerState = ""
            token inputs:daggerState.connect = </World/BucketExcavatorActionGraph/DaggerStateSubscriber.outputs:data>
            custom bool inputs:daggerTriggersReleased = 1
            bool inputs:daggerTriggersReleased.connect = </World/BucketExcavatorActionGraph/DaggerGamepadControls.outputs:triggersReleased>
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            uint inputs:execIn.connect = </World/BucketExcavatorActionGraph/DaggerGamepadControls.outputs:execOut>
            custom double[] inputs:gamepadAction
            double[] inputs:gamepadAction.connect = </World/BucketExcavatorActionGraph/GamepadActionArray.outputs:array>
            custom bool inputs:gamepadClawOpen
            bool inputs:gamepadClawOpen.connect = </World/BucketExcavatorActionGraph/GamepadClawOpenButton.outputs:pressed>
            custom float[] inputs:policyAction
            float[] inputs:policyAction.connect = </World/BucketExcavatorActionGraph/PolicyActionSubscriber.outputs:data>
            custom uint inputs:policyNanosec
            uint inputs:policyNanosec.connect = </World/BucketExcavatorActionGraph/StampedPolicySubscriber.outputs:header:stamp:nanosec>
            custom token inputs:policyRunId
            token inputs:policyRunId.connect = </World/BucketExcavatorActionGraph/StampedPolicySubscriber.outputs:header:frame_id>
            custom int inputs:policySec
            int inputs:policySec.connect = </World/BucketExcavatorActionGraph/StampedPolicySubscriber.outputs:header:stamp:sec>
            custom bool inputs:recordingMode
            bool inputs:recordingMode.connect = </World/BucketExcavatorActionGraph/RecordingModeSubscriber.outputs:data>
            custom string inputs:script = """
import math
import uuid

AXIS_TO_JOINT_SCALE = [-0.004, -0.004, -0.008, 0.003]
ACTION_DEADZONE = 0.25
AXIS_ACTION_SIZE = 4
ACTION_SIZE = 5
JOINT_SIZE = 6
OBSERVATION_STATE_SIZE = ACTION_SIZE
CLAW_STATE_INDEX = AXIS_ACTION_SIZE


def setup(db):
    _reset_action_mux_run(db)


def _reset_action_mux_run(db):
    # ScriptNode helpers share a globals namespace. Never call generic
    # setup() from compute: another node may have replaced that name.
    db.per_instance_state.last_policy_action = [0.0] * AXIS_ACTION_SIZE + [1.0]
    db.per_instance_state.gamepad_claw_closed = True
    db.per_instance_state.last_gamepad_claw_pressed = False
    db.per_instance_state.run_id = str(uuid.uuid4())
    db.per_instance_state.last_sim_time = None
    db.per_instance_state.pending_actions = {}
    db.per_instance_state.last_command_ns = -1
    db.per_instance_state.last_applied_ns = -1
    db.per_instance_state.splat_dagger_state = None
    db.per_instance_state.splat_dagger_claw = 1.0


def _clean_axis(value):
    try:
        value = float(value)
    except Exception:
        return 0.0
    if not math.isfinite(value):
        return 0.0
    return max(-1.0, min(1.0, value))


def _smooth_deadzone(value):
    value = _clean_axis(value)
    magnitude = abs(value)
    if magnitude <= ACTION_DEADZONE:
        return 0.0
    return math.copysign((magnitude - ACTION_DEADZONE) / (1.0 - ACTION_DEADZONE), value)


def _sized(values):
    values = list(values)
    out = [0.0] * AXIS_ACTION_SIZE + [1.0]
    for index, value in enumerate(values[:AXIS_ACTION_SIZE]):
        out[index] = _clean_axis(value)
    if len(values) > CLAW_STATE_INDEX:
        out[CLAW_STATE_INDEX] = 1.0 if _clean_axis(values[CLAW_STATE_INDEX]) > 0.5 else 0.0
    return out


def _sized_observation_joint_state(values):
    values = list(values)
    out = [0.0] * AXIS_ACTION_SIZE
    for index, value in enumerate(values[:AXIS_ACTION_SIZE]):
        try:
            value = float(value)
        except Exception:
            value = 0.0
        if not math.isfinite(value):
            value = 0.0
        out[index] = value
    return out


def _read_gamepad_action(db, state):
    gamepad_axes = list(db.inputs.gamepadAction)
    selected = [0.0] * ACTION_SIZE
    for index, value in enumerate(gamepad_axes[:AXIS_ACTION_SIZE]):
        selected[index] = _smooth_deadzone(value)

    gamepad_claw_pressed = bool(db.inputs.gamepadClawOpen)
    if (gamepad_claw_pressed and not state.last_gamepad_claw_pressed
            and state.splat_dagger_phase in ('off', 'correcting')):
        state.gamepad_claw_closed = not state.gamepad_claw_closed
    state.last_gamepad_claw_pressed = gamepad_claw_pressed
    selected[CLAW_STATE_INDEX] = 1.0 if state.gamepad_claw_closed else 0.0

    gamepad_active = gamepad_claw_pressed or any(
        abs(float(value)) > 1e-12 for value in selected[:AXIS_ACTION_SIZE]
    )
    return selected, gamepad_active


def compute(db):
    state = db.per_instance_state

    sim_time = float(db.inputs.simTime)
    now_ns = round(sim_time * 1000000000)
    if state.last_sim_time is not None and sim_time < state.last_sim_time:
        _reset_action_mux_run(db)
        state = db.per_instance_state
    state.last_sim_time = sim_time
    db.outputs.runId = state.run_id
    dagger_phase, dagger_enabled = splat_dagger_select_phase(db, state)
    if bool(db.inputs.simulationMode):
        ns = int(db.inputs.policySec) * 1000000000 + int(db.inputs.policyNanosec)
        command = list(db.inputs.stampedPolicy)
        if (str(db.inputs.policyRunId) == state.splat_dagger_run
                and dagger_phase in ('off', 'autonomous') and ns > state.last_command_ns
                and len(command) == ACTION_SIZE and now_ns - 100000000 <= ns <= now_ns + 1000000000):
            state.last_command_ns = ns
            state.pending_actions[ns] = _sized(command)
        due = [s for s in state.pending_actions if s <= now_ns]
        if due:
            state.last_applied_ns = max(due)
            state.last_policy_action = state.pending_actions[state.last_applied_ns]
            for s in due:
                del state.pending_actions[s]
        if state.last_applied_ns < 0 or now_ns - state.last_applied_ns > 400000000:
            state.last_policy_action = [0.0] * AXIS_ACTION_SIZE + [state.last_policy_action[-1]]
    policy = list(db.inputs.policyAction)
    if not bool(db.inputs.simulationMode) and len(policy) >= ACTION_SIZE:
        state.last_policy_action = _sized(policy)
    gamepad_selected, _ = _read_gamepad_action(db, state)

    recording_mode = (bool(db.inputs.recordingMode) if dagger_phase == 'off'
                      else dagger_phase == 'correcting')
    control_enabled = dagger_enabled
    if not control_enabled:
        selected = [0.0] * AXIS_ACTION_SIZE + [state.splat_dagger_claw]
    elif recording_mode:
        selected = gamepad_selected
    else:
        selected = list(state.last_policy_action)
        selected[CLAW_STATE_INDEX] = 1.0 if selected[CLAW_STATE_INDEX] > 0.5 else 0.0

    state.splat_dagger_claw = selected[CLAW_STATE_INDEX]
    observation_state = _sized_observation_joint_state(db.inputs.currentJointPositions)
    observation_state.append(selected[CLAW_STATE_INDEX])

    delta = [
        float(action) * float(scale)
        for action, scale in zip(selected[:AXIS_ACTION_SIZE], AXIS_TO_JOINT_SCALE)
    ]
    while len(delta) < JOINT_SIZE:
        delta.append(0.0)

    try:
        db.outputs.selectedAction_size = ACTION_SIZE
        db.outputs.observationState_size = OBSERVATION_STATE_SIZE
        db.outputs.jointDelta_size = JOINT_SIZE
    except Exception:
        pass
    db.outputs.selectedAction = selected
    db.outputs.observationState = observation_state
    db.outputs.jointDelta = delta
    db.outputs.clawClosed = selected[CLAW_STATE_INDEX] > 0.5
    return True

# SIMULATION_DAGGER_V2
def splat_dagger_select_phase(db, state):
    value = str(db.inputs.daggerState)
    phase, session, generation = 'off', 0, 0
    if value:
        try:
            a, b, phase = value.split(':')
            session, generation = int(a), int(b)
            assert 0 < session < 2**52 and 0 <= generation < 2**31
            assert phase in ('idle', 'autonomous', 'paused', 'correcting', 'armed')
        except (ValueError, AssertionError):
            phase, session, generation = 'idle', 0, 0
    counts = (int(db.inputs.daggerLeftCount), int(db.inputs.daggerRightCount))
    released = bool(db.inputs.daggerTriggersReleased)
    previous = getattr(state, 'splat_dagger_state', None)
    if previous is None:
        state.splat_dagger_counts = counts
    trigger_edge = counts != state.splat_dagger_counts
    state.splat_dagger_counts = counts
    if value != previous:
        claw = getattr(state, 'splat_dagger_claw', state.last_policy_action[-1])
        state.pending_actions.clear()
        state.last_command_ns = state.last_applied_ns = -1
        state.last_policy_action = [0.] * AXIS_ACTION_SIZE + [claw]
        state.gamepad_claw_closed = claw > .5
        state.splat_dagger_state = value
        state.splat_dagger_running = False
        state.splat_dagger_neutral = False
        state.splat_dagger_blocked = False
    requested_phase = phase
    if phase != 'off' and trigger_edge:
        # Hold on the input tick, before the ROS collector requests a new
        # generation. Old policy chunks cannot move the excavator meanwhile.
        state.splat_dagger_blocked = True
        state.pending_actions.clear()
        state.last_command_ns = state.last_applied_ns = -1
    blocked = state.splat_dagger_blocked or not released
    if phase == 'armed':
        axes_active = any(_smooth_deadzone(v) != 0.
                          for v in list(db.inputs.gamepadAction)[:AXIS_ACTION_SIZE])
        claw_pressed = bool(db.inputs.gamepadClawOpen)
        if not blocked and not axes_active and not claw_pressed:
            state.splat_dagger_neutral = True
        intent = axes_active or (claw_pressed and not state.last_gamepad_claw_pressed)
        if (not blocked and bool(db.inputs.controlEnabled)
                and state.splat_dagger_neutral and intent):
            state.splat_dagger_running = True
        phase = 'correcting' if state.splat_dagger_running else 'paused'
    if requested_phase not in ('off', 'idle') and blocked:
        phase = 'paused'
    state.splat_dagger_phase = phase
    state.splat_dagger_run = state.run_id + ('#' + value if value else '')
    enabled = bool(db.inputs.controlEnabled) and phase not in ('idle', 'paused')
    db.outputs.effectiveEnabled = enabled
    codes = {'idle': 0, 'autonomous': 1, 'paused': 2,
             'correcting': 3, 'off': 4, 'armed': 5}
    db.outputs.daggerTag_size = 8
    db.outputs.daggerTag = [2., float(session), float(generation),
                           float(codes[requested_phase]), float(enabled),
                           float(codes[phase]), float(counts[0]), float(counts[1])]
    return phase, enabled
"""
            custom token inputs:scriptPath
            custom double inputs:simTime
            double inputs:simTime.connect = </World/BucketExcavatorActionGraph/ReadActionSimTime.outputs:simulationTime>
            custom bool inputs:simulationMode
            bool inputs:simulationMode.connect = </World/BucketExcavatorActionGraph/SimulationModeSubscriber.outputs:data>
            custom double[] inputs:stampedPolicy
            double[] inputs:stampedPolicy.connect = </World/BucketExcavatorActionGraph/StampedPolicySubscriber.outputs:position>
            custom bool inputs:usePath
            token node:type = "omni.graph.scriptnode.ScriptNode"
            int node:typeVersion = 2
            custom bool outputs:clawClosed
            custom double[] outputs:daggerTag = []
            custom bool outputs:effectiveEnabled = 0
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
            custom double[] outputs:jointDelta
            custom float[] outputs:observationState
            custom token outputs:runId
            custom float[] outputs:selectedAction
