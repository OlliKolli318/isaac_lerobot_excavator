def compute(db):
    ns = round(float(db.inputs.simTime) * 1000000000)
    db.outputs.sec, db.outputs.nanosec = divmod(ns, 1000000000)
    values = list(db.inputs.state) + list(db.inputs.action)
    db.outputs.values_size = len(values)
    db.outputs.values = values
    return True
"""
