        def OmniGraphNode "DaggerGamepadControls"
        {
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            uint inputs:execIn.connect = </World/BucketExcavatorActionGraph/GamepadClawOpenButton.outputs:execOut>
            custom string inputs:script = """
def setup(db):
    import carb.input
    import omni.appwindow
    state = db.per_instance_state
    state.dagger_input = carb.input.acquire_input_interface()
    state.dagger_gamepad = None
    state.dagger_trigger_counts = [0, 0]
    state.dagger_trigger_down = None

def compute(db):
    import carb.input
    import omni.appwindow
    state = db.per_instance_state
    gamepad = omni.appwindow.get_default_app_window().get_gamepad(0)
    if gamepad != state.dagger_gamepad:
        state.dagger_gamepad = gamepad
        state.dagger_trigger_down = None
    values = [state.dagger_input.get_gamepad_value(gamepad, button) if gamepad else 0.
              for button in (carb.input.GamepadInput.LEFT_TRIGGER,
                             carb.input.GamepadInput.RIGHT_TRIGGER)]
    if state.dagger_trigger_down is None:
        # Do not replay a trigger already held at startup/reconnection.
        state.dagger_trigger_down = [value > .25 for value in values]
    for index, value in enumerate(values):
        if value > .55 and not state.dagger_trigger_down[index]:
            state.dagger_trigger_down[index] = True
            state.dagger_trigger_counts[index] += 1
        elif value < .25:
            state.dagger_trigger_down[index] = False
    db.outputs.leftCount, db.outputs.rightCount = state.dagger_trigger_counts
    db.outputs.triggersReleased = not any(state.dagger_trigger_down)
    return True
"""
            custom token inputs:scriptPath
            custom bool inputs:usePath
            token node:type = "omni.graph.scriptnode.ScriptNode"
            int node:typeVersion = 2
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
            custom uint64 outputs:leftCount = 0
            custom uint64 outputs:rightCount = 0
            custom bool outputs:triggersReleased = 1
            custom bool state:omni_initialized
        }
    }

    def Scope "Looks"
    {
        token visibility = "inherited"

        def Material "OmniGlass"
        {
            token outputs:mdl:displacement.connect = </World/Looks/OmniGlass/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/OmniGlass/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/OmniGlass/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniGlass.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniGlass"
                float inputs:cutout_opacity = 0
                bool inputs:enable_opacity = 1
                color3f inputs:glass_color = (1, 1, 1)
                token outputs:out (
                    renderType = "material"
                )
            }
        }

        def Material "PreviewSurface"
        {
            token outputs:displacement.connect = </World/Looks/PreviewSurface/Shader.outputs:displacement>
            token outputs:surface.connect = </World/Looks/PreviewSurface/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor = (0, 1, 0.03860998)
                token outputs:displacement
                token outputs:surface
            }
        }
    }

