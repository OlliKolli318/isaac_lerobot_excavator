def Xform "World"
{
    def "splat" (
        prepend payload = @./assets/environment/splat.usdz@
    )
    {
        token visibility = "inherited"
        quatf xformOp:orient = (0.91227174, -0.09331683, 0.06431817, -0.39359295)
        float3 xformOp:scale = (0.2, 0.2, 0.2)
        double3 xformOp:translate = (-0.24016914339866766, 0.5596272822250463, 0.6345785438548668)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "Cube" (
        active = false
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        double size = 1
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (0.7, 0.7, 0.7)
        double3 xformOp:translate = (0.8635874384706564, 0.519329162461442, 0.19397727857060712)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "excavator" (
        references = @./assets/robots/excavator_gripper.usd@</excavator>
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.2641355128367947, 0.4482538177287646, 0.4262003267414731)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "D435i"
        {
            quatf xformOp:orient = (0.974843, -0.02378651, 0.18067648, -0.12834051)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.11383071006442563, 0.09737859982712394, 0.19999999999999885)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "RSD435i"
            {
                over "Camera_OmniVision_OV2740_Color"
                {
                    bool omni:kit:cameraLock = 1
