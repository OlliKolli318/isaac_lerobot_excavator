            )
            delete uint inputs:execIn.connect = </World/BucketExcavatorActionGraph/OnPlaybackTick.outputs:tick>
            prepend uint inputs:execIn.connect = </World/BucketExcavatorActionGraph/OnPlaybackTick.outputs:tick>
            custom int[] inputs:jointIndices
