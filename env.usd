        def OmniGraphNode "TargetAccumulator" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom bool inputs:clawClosed
            bool inputs:clawClosed.connect = </World/BucketExcavatorActionGraph/ActionMux.outputs:clawClosed>
            custom bool inputs:clawManualMode
            bool inputs:clawManualMode.connect = </World/BucketExcavatorActionGraph/RecordingModeSubscriber.outputs:data>
            custom bool inputs:controlEnabled = 0
            bool inputs:controlEnabled.connect = </World/BucketExcavatorActionGraph/ActionMux.outputs:effectiveEnabled>
            custom double[] inputs:current
            prepend double[] inputs:current.connect = </World/BucketExcavatorActionGraph/ArticulationState.outputs:jointPositions>
            custom double[] inputs:delta
            prepend double[] inputs:delta.connect = </World/BucketExcavatorActionGraph/ActionMux.outputs:jointDelta>
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/BucketExcavatorActionGraph/ActionMux.outputs:execOut>
            custom string inputs:script = """# Splat recording/policy contract v1. Standalone OmniGraph ScriptNode program.
import math

SPLAT_TARGET_OPEN = math.radians(50.0)
SPLAT_TARGET_STEP = math.radians(1.2)
SPLAT_TARGET_WINDUP = math.radians(2.0)


def setup(db):
    state = db.per_instance_state
    state.target = []
    state.last_sim_time = None
    state.claw_closed = None
    state.claw_goal = None


def compute(db):
    state = db.per_instance_state
    current = [float(x) for x in db.inputs.current]
    delta = [float(x) for x in db.inputs.delta]
    sim_time = float(db.inputs.simTime)
    if len(current) != 6 or len(delta) != 6 or not all(math.isfinite(x) for x in current + delta):
        return False
    if state.last_sim_time is None or sim_time < state.last_sim_time:
        state.target = list(current)
        state.claw_closed = None
        state.claw_goal = None
        elapsed = 0.0
    else:
        elapsed = max(0.0, min(0.1, sim_time - state.last_sim_time))
    state.last_sim_time = sim_time
    closed = bool(db.inputs.clawClosed)
    if not bool(db.inputs.controlEnabled):
        # Freeze the last commanded targets, including their load-supporting
        # position error. Following measured positions here every tick would
        # remove the restoring drive force and let gravity keep lowering them.
        # Startup/rewind still initializes targets from measured positions above.
        state.claw_closed = None
        state.claw_goal = None
    else:
        # Both manual and policy commands use this same actuator path.
        tick_scale = elapsed * 60.0
        for index, step in enumerate(delta[:4]):
            if abs(step) > 1e-12:
                error = state.target[index] - current[index]
                state.target[index] = current[index] + max(-SPLAT_TARGET_WINDUP, min(SPLAT_TARGET_WINDUP, error))
            state.target[index] += step * tick_scale
        if closed != state.claw_closed:
            state.claw_closed = closed
            state.claw_goal = 0.0 if closed else SPLAT_TARGET_OPEN
        if state.claw_goal is not None:
            master = abs(state.target[4])
            difference = state.claw_goal - master
            step = SPLAT_TARGET_STEP * tick_scale
            master += max(-step, min(step, difference))
            state.target[4:] = [master, -master]
            if abs(master - state.claw_goal) < 1e-6:
                state.claw_goal = None
        else:
            state.target[5] = -abs(state.target[4])
    db.outputs.target = list(state.target)
    db.outputs.target_size = 6
    return True
"""
