<?xml version="1.0"?>
<package format="3">
  <name>kaivuri_lerobot_bridge</name>
  <version>0.2.0</version>
  <description>Safety-oriented ROS 2 control bridge for the Isaac LeRobot excavator.</description>
  <maintainer email="olli.kangasniemi@savonia.fi">Kaivuri maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <test_depend>ament_pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
