<?xml version="1.0" encoding="UTF-8"?>
<!-- Docker policy receiver on NetBird 100.94.87.249 (Fast DDS 2.14).
     Measured 2026-11-23: two 512x512 rgb8 streams, 786492 serialized
     bytes per image. Combined payload was 13.53-16.73 MB/s at 8.6-10.6
     wall-clock frames/s; the scene timestamps advance at 60 frames/s.
     A 16 MiB receive request provides burst headroom; the Docker host must
     allow net.core.rmem_max >= 16777216 for that request to take effect.
     Socket buffers are local to each socket, not ROS subscription queues.
     Restrict advertised interfaces to NetBird and loopback, avoiding a
     second data path through the container's LAN address.
     Discovery peers and ROS_DOMAIN_ID remain controlled by the environment. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>KaivuriPolicyNetBirdUdp</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>1048576</sendBufferSize>
      <receiveBufferSize>16777216</receiveBufferSize>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
        <address>100.94.87.249</address>
      </interfaceWhiteList>
      <maxInitialPeersRange>32</maxInitialPeersRange>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="kaivuri_policy_netbird" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>KaivuriPolicyNetBirdUdp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
