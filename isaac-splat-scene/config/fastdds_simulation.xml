<?xml version="1.0" encoding="UTF-8"?>
<!-- Process-local UDP profile for the two raw RGB streams.
     Does not change machine-wide socket settings or ROS topic QoS. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>KaivuriBufferedUdp</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>16777216</sendBufferSize>
      <receiveBufferSize>16777216</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="kaivuri_buffered_udp" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>KaivuriBufferedUdp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
